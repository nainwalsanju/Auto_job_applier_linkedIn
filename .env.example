# LinkedIn Auto Job Applier - Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ============================================
# LinkedIn Credentials
# ============================================
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_secure_password

# ============================================
# AI Provider Configuration
# ============================================
# AI Provider: "openai", "deepseek", "gemini"
AI_PROVIDER=deepseek

# OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key

# DeepSeek API Key (from https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# LLM Configuration
# ============================================
# API URL for LLM (adjust based on provider)
LLM_API_URL=https://api.deepseek.com/v1

# Model name to use
LLM_MODEL=deepseek-chat

# API Specification: "openai", "openai-like"
LLM_SPEC=openai

# Enable streaming for AI responses (True/False)
STREAM_OUTPUT=False

# ============================================
# Application Settings
# ============================================
# Run in background mode (True/False)
RUN_IN_BACKGROUND=False

# Enable stealth mode to avoid bot detection (True/False)
STEALTH_MODE=False

# Click gap in seconds
CLICK_GAP=1

# ============================================
# Logging
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log in JSON format (for production)
LOG_JSON_FORMAT=False
